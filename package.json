{
  "name": "rendertrail",
  "version": "0.0.0",
  "private": true,
  "description": "MCP App that records how React components render in headless Chrome and explains the main performance problem in a card inside Claude",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/server.js",
  "scripts": {
    "build": "npm run typecheck && npm run build:card && npm run build:server && npm run build:instrument",
    "build:card": "vite build",
    "build:server": "esbuild src/server/main.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/server.js",
    "build:instrument": "esbuild src/recorder/page/instrument.ts --bundle --platform=browser --format=iife --target=es2022 --minify-syntax --keep-names --outfile=dist/instrument.js",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/recorder/page/tsconfig.json && tsc -p ui/tsconfig.json",
    "test": "vitest run",
    "test:golden": "npm run build && vitest run --config vitest.golden.config.ts",
    "start": "node dist/server.js",
    "start:http": "node dist/server.js --http"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "bippy": "0.7.3",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "vite": "^8.3.6",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  }
}
