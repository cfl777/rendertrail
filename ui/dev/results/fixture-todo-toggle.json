        "path": "data.ts",
        "content": "export type Todo = { id: number; title: string; done: boolean };\n\n// 100 todos; every fourth one starts done, so 75 are open.\nexport const TODOS: Todo[] = Array.from({ length: 100 }, (_, i) => ({\n  id: i + 1,\n  title: `Task ${i + 1}`,\n  done: i % 4 === 0,\n}));\n"
      },
      {
        "path": "TodoApp.tsx",
        "content": "import { useState, type FormEvent } from 'react';\nimport { TODOS } from './data';\nimport { TodoFooter, TodoItem } from './TodoItem';\n\nexport default function TodoApp() {\n  const [todos, setTodos] = useState(TODOS);\n  const [draft, setDraft] = useState('');\n\n  function handleToggle(id: number) {\n    setTodos((prev) => prev.map((t) => (t.id === id ? { ...t, done: !t.done } : t)));\n  }\n\n  function handleAdd(event: FormEvent) {\n    event.preventDefault();\n    setTodos((prev) => [...prev, { id: prev.length + 1, title: draft, done: false }]);\n    setDraft('');\n  }\n\n  const remaining = todos.filter((t) => !t.done).length;\n\n  return (\n    <section>\n      <form onSubmit={handleAdd}>\n        <input aria-label=\"New todo\" value={draft} onChange={(e) => setDraft(e.target.value)} />\n        <button type=\"submit\">Add</button>\n      </form>\n      <ul>\n        {todos.map((todo) => (\n          <TodoItem key={todo.id} todo={todo} onToggle={handleToggle} />\n        ))}\n      </ul>\n      <TodoFooter remaining={remaining} />\n    </section>\n  );\n}\n"
      },
      {
        "path": "TodoItem.tsx",
        "content": "import { memo } from 'react';\nimport type { Todo } from './data';\n\n// Deliberately slow (about 0.05 ms per item, about 0.1 ms with timer rounding) so wasted renders cost real time.\nfunction busyWait(ms: number) {\n  const end = performance.now() + ms;\n  while (performance.now() < end) {\n    // do nothing\n  }\n}\n\ntype TodoItemProps = {\n  todo: Todo;\n  onToggle: (id: number) => void;\n};\n\nexport const TodoItem = memo(function TodoItem({ todo, onToggle }: TodoItemProps) {\n  busyWait(0.05);\n  return (\n    <li>\n      <input\n        type=\"checkbox\"\n        aria-label={`Toggle ${todo.title}`}\n        checked={todo.done}\n        onChange={() => onToggle(todo.id)}\n      />\n      {todo.title}\n    </li>\n  );\n});\n\nexport const TodoFooter = memo(function TodoFooter({ remaining }: { remaining: number }) {\n  return <footer>{remaining} left</footer>;\n});\n"
      }
    ],
