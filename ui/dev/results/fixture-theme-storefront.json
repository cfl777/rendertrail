        "path": "data.ts",
        "content": "import { createContext } from 'react';\n\nexport type Theme = 'light' | 'dark';\nexport type Product = { id: number; name: string; price: number };\n\nexport const ThemeContext = createContext<Theme>('light');\n\n// 40 products with deterministic names and prices.\nexport const PRODUCTS: Product[] = Array.from({ length: 40 }, (_, i) => ({\n  id: i + 1,\n  name: `Product ${i + 1}`,\n  price: 10 + ((i * 7) % 50),\n}));\n"
      },
      {
        "path": "ProductGrid.tsx",
        "content": "import { memo, useContext } from 'react';\nimport { ThemeContext, type Product } from './data';\n\n// Deliberately slow (about 0.1 ms per card) so the renders cost real time.\nfunction busyWait(ms: number) {\n  const end = performance.now() + ms;\n  while (performance.now() < end) {\n    // do nothing\n  }\n}\n\nexport const ProductCard = memo(function ProductCard({ product }: { product: Product }) {\n  const theme = useContext(ThemeContext);\n  busyWait(0.1);\n  return (\n    <li data-theme={theme}>\n      {product.name}: {product.price} EUR\n    </li>\n  );\n});\n\ntype Layout = { columns: number; gap: number };\n\nexport const ProductGrid = memo(function ProductGrid({ products, layout }: { products: Product[]; layout: Layout }) {\n  const theme = useContext(ThemeContext);\n  return (\n    <ul data-theme={theme} data-columns={layout.columns} data-gap={layout.gap}>\n      {products.map((product) => (\n        <ProductCard key={product.id} product={product} />\n      ))}\n    </ul>\n  );\n});\n\nexport const PromoBanner = memo(function PromoBanner({ text }: { text: string }) {\n  return <p>{text}</p>;\n});\n"
      },
      {
        "path": "Storefront.tsx",
        "content": "import { useState } from 'react';\nimport { PRODUCTS, ThemeContext, type Theme } from './data';\nimport { ProductGrid, PromoBanner } from './ProductGrid';\n\nexport default function Storefront() {\n  const [theme, setTheme] = useState<Theme>('light');\n\n  return (\n    <ThemeContext.Provider value={theme}>\n      <button\n        aria-label=\"Toggle theme\"\n        onClick={() => setTheme((t) => (t === 'light' ? 'dark' : 'light'))}\n      >\n        {theme === 'light' ? 'Dark mode' : 'Light mode'}\n      </button>\n      <PromoBanner text=\"Free shipping over 50 EUR\" />\n      <ProductGrid products={PRODUCTS} layout={{ columns: 4, gap: 12 }} />\n    </ThemeContext.Provider>\n  );\n}\n"
      }
    ],
