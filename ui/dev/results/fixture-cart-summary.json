        "path": "Cart.tsx",
        "content": "import { useState } from 'react';\nimport { INITIAL_CART, type CartItem } from './data';\nimport { CartSummary } from './CartSummary';\n\nfunction CartLine({ item, onChange }: { item: CartItem; onChange: (id: string, delta: number) => void }) {\n  return (\n    <li>\n      {item.name} × {item.qty}\n      <button aria-label={`Remove one ${item.name}`} onClick={() => onChange(item.id, -1)}>−</button>\n      <button aria-label={`Add one ${item.name}`} onClick={() => onChange(item.id, 1)}>+</button>\n    </li>\n  );\n}\n\nexport default function Cart() {\n  const [items, setItems] = useState(INITIAL_CART);\n\n  function handleChange(id: string, delta: number) {\n    setItems((prev) =>\n      prev.map((item) => (item.id === id ? { ...item, qty: Math.max(0, item.qty + delta) } : item)),\n    );\n  }\n\n  return (\n    <main>\n      <ul>\n        {items.map((item) => (\n          <CartLine key={item.id} item={item} onChange={handleChange} />\n        ))}\n      </ul>\n      <CartSummary items={items} />\n    </main>\n  );\n}\n"
      },
      {
        "path": "CartSummary.tsx",
        "content": "import { useEffect, useState } from 'react';\nimport { quoteShipping, type CartItem } from './data';\n\n// Deliberately slow (about 0.3 ms per render) so the extra update costs real time.\nfunction busyWait(ms: number) {\n  const end = performance.now() + ms;\n  while (performance.now() < end) {\n    // do nothing\n  }\n}\n\nfunction useShippingQuote(total: number) {\n  const [quote, setQuote] = useState<number | null>(null);\n  useEffect(() => {\n    let ignore = false;\n    quoteShipping(total).then((value) => {\n      if (!ignore) setQuote(value);\n    });\n    return () => {\n      ignore = true;\n    };\n  }, [total]);\n  return quote;\n}\n\nexport function CartSummary({ items }: { items: CartItem[] }) {\n  const [total, setTotal] = useState(() => items.reduce((sum, item) => sum + item.price * item.qty, 0));\n  useEffect(() => {\n    setTotal(items.reduce((sum, item) => sum + item.price * item.qty, 0));\n  }, [items]);\n  const shipping = useShippingQuote(total);\n\n  busyWait(0.3);\n  return (\n    <aside>\n      <p>Total: {total.toFixed(2)} EUR</p>\n      <p>Shipping: {shipping === null ? '…' : `${shipping.toFixed(2)} EUR`}</p>\n    </aside>\n  );\n}\n"
      },
      {
        "path": "data.ts",
        "content": "export type CartItem = { id: string; name: string; price: number; qty: number };\n\nexport const INITIAL_CART: CartItem[] = [\n  { id: 'mat', name: 'Yoga mat', price: 39.0, qty: 1 },\n  { id: 'roller', name: 'Foam roller', price: 24.5, qty: 2 },\n  { id: 'band', name: 'Resistance band', price: 12.0, qty: 1 },\n];\n\n// Stands in for a shipping API: 5 % of the total, rounded to cents. No network.\nexport function quoteShipping(total: number): Promise<number> {\n  return Promise.resolve(Math.round(total * 5) / 100);\n}\n"
      }
    ],
