        "path": "data.ts",
        "content": "export type User = { id: number; name: string; email: string; role: Role };\nexport type Role = 'admin' | 'editor' | 'viewer';\n\nexport const ROLES: Role[] = ['admin', 'editor', 'viewer'];\n\n// 150 users with deterministic names and roles.\nexport const USERS: User[] = Array.from({ length: 150 }, (_, i) => ({\n  id: i + 1,\n  name: `User ${i + 1}`,\n  email: `user${i + 1}@example.test`,\n  role: ROLES[i % ROLES.length],\n}));\n"
      },
      {
        "path": "UserAdmin.tsx",
        "content": "import { useState } from 'react';\nimport { ROLES, USERS } from './data';\nimport { FilterPanel, UserTable } from './UserTable';\n\nexport default function UserAdmin() {\n  const [filtersOpen, setFiltersOpen] = useState(false);\n\n  return (\n    <div>\n      <button aria-label=\"Toggle filters\" onClick={() => setFiltersOpen((open) => !open)}>\n        {filtersOpen ? 'Hide filters' : 'Show filters'}\n      </button>\n      <FilterPanel open={filtersOpen} roles={ROLES} />\n      <UserTable users={USERS} columns={['name', 'email', 'role']} />\n    </div>\n  );\n}\n"
      },
      {
        "path": "UserTable.tsx",
        "content": "import { memo } from 'react';\nimport type { Role, User } from './data';\n\n// Deliberately slow (about 0.06 ms per row) so wasted renders cost real time.\nfunction busyWait(ms: number) {\n  const end = performance.now() + ms;\n  while (performance.now() < end) {\n    // do nothing\n  }\n}\n\ntype Column = keyof Omit<User, 'id'>;\n\nfunction UserRow({ user, columns }: { user: User; columns: Column[] }) {\n  busyWait(0.06);\n  return (\n    <tr>\n      {columns.map((column) => (\n        <td key={column}>{user[column]}</td>\n      ))}\n    </tr>\n  );\n}\n\nexport const UserTable = memo(function UserTable({ users, columns }: { users: User[]; columns: Column[] }) {\n  return (\n    <table>\n      <thead>\n        <tr>\n          {columns.map((column) => (\n            <th key={column}>{column}</th>\n          ))}\n        </tr>\n      </thead>\n      <tbody>\n        {users.map((user) => (\n          <UserRow key={user.id} user={user} columns={columns} />\n        ))}\n      </tbody>\n    </table>\n  );\n});\n\nexport const FilterPanel = memo(function FilterPanel({ open, roles }: { open: boolean; roles: Role[] }) {\n  if (!open) return null;\n  return (\n    <aside>\n      {roles.map((role) => (\n        <label key={role}>\n          <input type=\"checkbox\" /> {role}\n        </label>\n      ))}\n    </aside>\n  );\n});\n"
      }
