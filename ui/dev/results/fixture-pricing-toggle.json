        "path": "data.ts",
        "content": "export type Billing = 'monthly' | 'yearly';\nexport type Plan = { id: string; name: string; monthly: number };\nexport type Feature = { id: number; name: string; plans: string[] };\nexport type Labels = { included: string; missing: string };\n\nexport const PLANS: Plan[] = [\n  { id: 'solo', name: 'Solo', monthly: 18 },\n  { id: 'team', name: 'Team', monthly: 79 },\n  { id: 'studio', name: 'Studio', monthly: 149 },\n];\n\n// 80 features; each is in Studio, two thirds are in Team, one third in Solo.\nexport const FEATURES: Feature[] = Array.from({ length: 80 }, (_, i) => ({\n  id: i + 1,\n  name: `Feature ${i + 1}`,\n  plans: ['studio', ...(i % 3 !== 0 ? ['team'] : []), ...(i % 3 === 2 ? ['solo'] : [])],\n}));\n\nexport function priceFor(monthly: number, billing: Billing, discount: number): number {\n  const base = billing === 'yearly' ? monthly * 12 : monthly;\n  return Math.round(base * (1 - discount));\n}\n"
      },
      {
        "path": "FeatureMatrix.tsx",
        "content": "import { memo } from 'react';\nimport type { Feature, Labels, Plan } from './data';\n\n// Deliberately slow (about 0.1 ms per row) so wasted renders cost real time.\nfunction busyWait(ms: number) {\n  const end = performance.now() + ms;\n  while (performance.now() < end) {\n    // do nothing\n  }\n}\n\nfunction FeatureRow({ feature, plans, labels }: { feature: Feature; plans: Plan[]; labels: Labels }) {\n  busyWait(0.1);\n  return (\n    <tr>\n      <th>{feature.name}</th>\n      {plans.map((plan) => (\n        <td key={plan.id}>{feature.plans.includes(plan.id) ? labels.included : labels.missing}</td>\n      ))}\n    </tr>\n  );\n}\n\ntype FeatureMatrixProps = { features: Feature[]; plans: Plan[]; labels: Labels };\n\nexport const FeatureMatrix = memo(function FeatureMatrix({ features, plans, labels }: FeatureMatrixProps) {\n  return (\n    <table>\n      <tbody>\n        {features.map((feature) => (\n          <FeatureRow key={feature.id} feature={feature} plans={plans} labels={labels} />\n        ))}\n      </tbody>\n    </table>\n  );\n});\n\nexport const PlanCard = memo(function PlanCard({ name, price }: { name: string; price: number }) {\n  return (\n    <article>\n      <h2>{name}</h2>\n      <p>{price} EUR</p>\n    </article>\n  );\n});\n"
      },
      {
        "path": "PricingPage.tsx",
        "content": "import { useEffect, useState } from 'react';\nimport { FEATURES, PLANS, priceFor, type Billing } from './data';\nimport { FeatureMatrix, PlanCard } from './FeatureMatrix';\n\nexport default function PricingPage() {\n  const [billing, setBilling] = useState<Billing>('monthly');\n  const [discount, setDiscount] = useState(0);\n  useEffect(() => {\n    setDiscount(billing === 'yearly' ? 0.2 : 0);\n  }, [billing]);\n\n  return (\n    <main>\n      <button\n        aria-label=\"Toggle yearly billing\"\n        onClick={() => setBilling((b) => (b === 'monthly' ? 'yearly' : 'monthly'))}\n      >\n        {billing === 'monthly' ? 'Monthly' : 'Yearly (save 20 %)'}\n      </button>\n      {PLANS.map((plan) => (\n        <PlanCard key={plan.id} name={plan.name} price={priceFor(plan.monthly, billing, discount)} />\n      ))}\n      <FeatureMatrix\n        features={FEATURES}\n        plans={PLANS}\n        labels={{ included: 'Included', missing: 'Not included' }}\n      />\n    </main>\n  );\n}\n"
      }
    ],
